# Copy this file to .env.playwright and fill in your test credentials.
# .env.playwright is gitignored — never commit real credentials.
# In GitHub Actions, these are set as repository secrets instead.

# Supabase connection (same as .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Test user credentials — must exist in your Supabase project
TEST_OWNER_EMAIL=owner@yourdomain.com
TEST_OWNER_PASSWORD=your-owner-password

TEST_COORDINATOR_EMAIL=carecoordinator@demo.com
TEST_COORDINATOR_PASSWORD=your-coordinator-password

# Defaults to http://localhost:3000 if not set
# PLAYWRIGHT_BASE_URL=http://localhost:3000
