{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    },
    "logLevel": {
      "default": "Information",
      "Host.Results": "Information",
      "Function": "Information"
    }
  },
  "extensions": {
    "queues": {
      "messageEncoding": "none",
      "batchSize": 8,
      "newBatchThreshold": 4,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:05:00"
    }
  }
}
